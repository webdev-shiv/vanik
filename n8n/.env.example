# ============================================================================
# Merchant Growth AI - n8n Environment & Supabase Credentials Configuration
# ============================================================================
# IMPORTANT SECURITY RULES:
# 1. NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend client bundle or browser!
# 2. Frontend clients only communicate with Spring Boot (/api/*) or use SUPABASE_ANON_KEY with RLS.
# 3. Service-role credentials must remain strictly inside secure server environments (n8n, Spring Boot).
# ============================================================================

# --- Supabase Database & PostgREST Configuration ---
SUPABASE_URL=https://your-project.supabase.co
# Least-privilege key for authenticated/public read queries (governed by Row-Level Security)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Elevated backend key for n8n orchestrator writes (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Internal Service URLs (VPC / Localhost) ---
BACKEND_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# --- OpenAI Configuration ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- n8n Orchestrator Configuration ---
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
